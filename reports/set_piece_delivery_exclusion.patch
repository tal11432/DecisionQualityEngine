+def set_piece_delivery_mask(events: pd.DataFrame, max_gap_s: float = SET_PIECE_MAX_GAP_S) -> pd.Series:
+    """True for PASS / BALL LOST events that ARE the delivery of a restart (throw-in, free kick, corner, kick-off ...).
+
+    Metrica records a restart as a zero-duration ``SET PIECE`` marker ("the player brings the ball back into play")
+    immediately followed by the ``PASS`` (or the failed-pass ``BALL LOST``) by the SAME player at the same instant.
+    Marker and delivery are one action, so the delivery is not an open-play ground pass. Rule: the event immediately
+    preceding it in the table is a SET PIECE of the same team and the same player, in the same period, ending at most
+    ``max_gap_s`` before it. ``events`` must be the FULL event table in chronological order (ties in file order); the
+    result is aligned to ``events.index``. Only type/team/player/period/time columns are read (no outcome information).
+    """
+    ev = events.sort_index()
+    prev = ev.shift(1)
+    m = ((ev["type"].isin(["PASS", "BALL LOST"])) & (prev["type"] == "SET PIECE") & (prev["team"] == ev["team"])
+         & (prev["from_player"] == ev["from_player"]) & (prev["period"] == ev["period"])
+         & ((ev["start_time_s"] - prev["end_time_s"]) <= max_gap_s))
+    return m.reindex(events.index, fill_value=False)
+
+
+def candidate_events(events: pd.DataFrame, exclude_set_piece_deliveries: bool = True) -> pd.DataFrame:
+    """In-universe events with label from type/subtype ONLY. Other columns are not read here.
+
+    Set-piece deliveries (see ``set_piece_delivery_mask``) are not open-play passes and are left out unless
+    ``exclude_set_piece_deliveries=False`` (legacy population, used to reproduce earlier reports)."""
+    if exclude_set_piece_deliveries:
+        events = events[~set_piece_delivery_mask(events)]
     comp = events[(events["type"] == "PASS") & events["subtype"].isna()].assign(label=0)
     icpt = events[(events["type"] == "BALL LOST") & (events["subtype"] == "INTERCEPTION")].assign(label=1)
     return pd.concat([comp, icpt]).sort_index()
